{
  "version": 1,
  "lineLength": 120,
  "indentation": { "spaces": 4 },
  "maximumBlankLines": 1,
  "respectsExistingLineBreaks": true,
  "lineBreakBeforeEachArgument": true,
  "rules": { "AlwaysUseLowerCamelCase": false, "NeverForceUnwrap": true, "NeverUseForceTry": true, "AllPublicDeclarationsHaveDocumentation": true }
}
